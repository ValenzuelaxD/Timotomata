{
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "${env:LOCALAPPDATA}/Timotomata/out",
    "java.project.referencedLibraries": [
        "${env:LOCALAPPDATA}/Timotomata/javafx-sdk-23.0.2/lib/**/*.jar",
        "${env:LOCALAPPDATA}/Timotomata/richtextfx/*.jar"
    ],
    "java.inlayHints.parameterNames.enabled": "none",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms100m -Xlog:disable"
}
